apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: cloudnativemauritius
  name: cloudnativemauritius
spec:
  replicas: 3
  selector:
    matchLabels:
      app: cloudnativemauritius
  strategy:
    type: RollingUpdate
  template:
    metadata:
      creationTimestamp: null
      labels:
        app: cloudnativemauritius
    spec:
      containers:
        - image: registry.alexbissessur.dev/meetups:{{ version }}
          name: cloudnativemauritius
          ports:
            - containerPort: 8080
          envFrom:
            - configMapRef:
                name: env-cfm

          env:
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: env-secret
                  key: MYSQL_USER

            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: env-secret
                  key: MYSQL_PASSWORD

            - name: DB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: env-secret
                  key: MYSQL_DATABASE
          imagePullPolicy: Always

      imagePullSecrets:
        - name: regcred
